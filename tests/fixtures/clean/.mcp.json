{
  "mcpServers": {
    "notes": {
      "command": "node",
      "args": [
        "server.js"
      ]
    },
    "web-search": {
      "command": "npx",
      "args": [
        "-y",
        "brave-search-mcp@1.2.0"
      ]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-postgres@0.6.2",
        "postgresql://localhost/app"
      ]
    }
  }
}
